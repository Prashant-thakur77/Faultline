# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
.next/
out/
dist/
*.tsbuildinfo
npm-debug.log*

# Data artifacts (regenerated by pipeline; seeds are committed)
data/warehouse/*.duckdb
data/warehouse/*.duckdb.wal
data/generated/
# Incident records are ephemeral run-state (curated copies live in examples/)
data/incidents/

# OS / editor
.DS_Store
.idea/
.vscode/

# Logs & scratch
*.log
tmp/
.playwright/
test-results/
playwright-report/

# Demo video renders and their build scratch. The published demo goes to YouTube; one final cut is kept in the repo
# (docs/media/demo.mp4) so the README link works before and without YouTube.
*.mp4
!docs/media/demo.mp4
video-build/
.claude/settings.local.json
deploy/users.acl
evals/results/tmp/
docs/audit/*.log

.cache/
