// Faultline schema: the single source of truth for indexes (applied per graph by scripts/seed.py
// and re-applied after every GRAPH.COPY). One statement per line; "already indexed" is tolerated.
// Range indexes on every id (plus Deploy.at and Intent.idem). Every node also has :Node(id) for cross-label lookups.
CREATE INDEX FOR (n:Node) ON (n.id)
CREATE INDEX FOR (n:KPI) ON (n.id)
CREATE INDEX FOR (n:Dashboard) ON (n.id)
CREATE INDEX FOR (n:Table) ON (n.id)
CREATE INDEX FOR (n:Column) ON (n.id)
CREATE INDEX FOR (n:Transform) ON (n.id)
CREATE INDEX FOR (n:Job) ON (n.id)
CREATE INDEX FOR (n:Service) ON (n.id)
CREATE INDEX FOR (n:Endpoint) ON (n.id)
CREATE INDEX FOR (n:Datastore) ON (n.id)
CREATE INDEX FOR (n:ExternalDependency) ON (n.id)
CREATE INDEX FOR (n:Repo) ON (n.id)
CREATE INDEX FOR (n:File) ON (n.id)
CREATE INDEX FOR (n:Commit) ON (n.id)
CREATE INDEX FOR (n:PR) ON (n.id)
CREATE INDEX FOR (n:Deploy) ON (n.id)
CREATE INDEX FOR (n:Deploy) ON (n.at)
CREATE INDEX FOR (n:FeatureFlag) ON (n.id)
CREATE INDEX FOR (n:ChangeFact) ON (n.id)
CREATE INDEX FOR (n:Alert) ON (n.id)
CREATE INDEX FOR (n:Incident) ON (n.id)
CREATE INDEX FOR (n:Symptom) ON (n.id)
CREATE INDEX FOR (n:Hypothesis) ON (n.id)
CREATE INDEX FOR (n:Evidence) ON (n.id)
CREATE INDEX FOR (n:GateRun) ON (n.id)
CREATE INDEX FOR (n:MetricWindow) ON (n.id)
CREATE INDEX FOR (n:MetricWindow) ON (n.target_id)
CREATE INDEX FOR (n:Baseline) ON (n.id)
CREATE INDEX FOR (n:Anomaly) ON (n.id)
CREATE INDEX FOR (n:Person) ON (n.id)
CREATE INDEX FOR (n:Team) ON (n.id)
CREATE INDEX FOR (n:Runbook) ON (n.id)
CREATE INDEX FOR (n:Decision) ON (n.id)
CREATE INDEX FOR (n:Postmortem) ON (n.id)
CREATE INDEX FOR (n:Doc) ON (n.id)
CREATE INDEX FOR (n:Intent) ON (n.idem)
CREATE INDEX FOR (n:Action) ON (n.id)
CREATE INDEX FOR (n:Approval) ON (n.id)
CREATE INDEX FOR (n:Task) ON (n.id)
CREATE INDEX FOR (n:Agent) ON (n.id)
CREATE INDEX FOR (n:Session) ON (n.id)
CREATE INDEX FOR (n:Turn) ON (n.id)
CREATE INDEX FOR (n:Run) ON (n.id)
CREATE INDEX FOR (n:ToolCall) ON (n.id)
CREATE INDEX FOR (n:StageEvent) ON (n.id)
CREATE INDEX FOR (n:SLO) ON (n.id)
CREATE INDEX FOR (n:Customer) ON (n.id)
CREATE INDEX FOR (n:IntentExemplar) ON (n.id)
// Full-text (DDL form only; never on an attribute that also has a range index, 6.0 #3248)
CREATE FULLTEXT INDEX FOR (n:Service) ON (n.name)
CREATE FULLTEXT INDEX FOR (n:Table) ON (n.name)
CREATE FULLTEXT INDEX FOR (n:Runbook) ON (n.title)
CREATE FULLTEXT INDEX FOR (n:Decision) ON (n.title)
CREATE FULLTEXT INDEX FOR (n:Postmortem) ON (n.summary)
CREATE FULLTEXT INDEX FOR (n:Doc) ON (n.title)
CREATE FULLTEXT INDEX FOR (n:IntentExemplar) ON (n.text)
// Vector (384-dim cosine; written only via vecf32(); query score is a distance)
CREATE VECTOR INDEX FOR (n:Incident) ON (n.embedding) OPTIONS {dimension:384, similarityFunction:'cosine'}
CREATE VECTOR INDEX FOR (n:Runbook) ON (n.embedding) OPTIONS {dimension:384, similarityFunction:'cosine'}
CREATE VECTOR INDEX FOR (n:Postmortem) ON (n.embedding) OPTIONS {dimension:384, similarityFunction:'cosine'}
CREATE VECTOR INDEX FOR (n:IntentExemplar) ON (n.embedding) OPTIONS {dimension:384, similarityFunction:'cosine'}
