{
  "name": "Faultline (keyless judge-check)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm@sha256:7876580dc67fd460fd962f004cbeb480027e9bbc0657096f1087db11f9eaff39",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2.12.2": {},
    "ghcr.io/devcontainers/features/node:1.6.2": { "version": "20" }
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "postCreateCommand": "pip install --user uv==0.10.9 && make setup",
  "postAttachCommand": "echo 'Run: make judge-check   (keyless; pinned FalkorDB in Docker; prints PASS)'",
  "forwardPorts": [3000, 8400, 6379],
  "portsAttributes": {
    "3000": { "label": "Faultline UI (make demo)" },
    "8400": { "label": "Faultline API (make demo)" },
    "6379": { "label": "FalkorDB (pinned)", "onAutoForward": "ignore" }
  },
  "containerEnv": { "FAULTLINE_PUBLIC": "false" }
}
