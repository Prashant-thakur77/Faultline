# Faultline configuration. Copy to .env and fill in values. NEVER commit .env.
# Required for live agent runs (not for `make judge-check`):
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_SPECIALIST_MODEL=claude-sonnet-5-5
# Optional second-family judge for explanation-quality scoring (evals/judge_crossmodel.py):
JUDGE_API_KEY=
LLM_SPEND_CAP_USD_PER_HOUR=3

# FalkorDB (pinned by digest in deploy/docker-compose.yml; see docs/FALKORDB_COMPAT.md)
FALKORDB_IMAGE=falkordb/falkordb@sha256:107455e862a824e45e8e9f5a7fbfdf5e00a08b14e13eae2577c72fd9e3f59ba6
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# Engine user (seed/write-back). Empty = default user (local dev without ACL).
FALKORDB_ENGINE_USER=
FALKORDB_ENGINE_PASSWORD=
# Read-only tenant users ro_<tenant> (GRAPH.RO_QUERY only). Empty = RO via default user (dev; /api/status says so).
FALKORDB_RO_PASSWORD=
FALKORDB_TIMEOUT_MS=2000
FALKORDB_CYPHER_TIMEOUT_MS=3000
FALKORDB_RESULT_LIMIT=100
FAULTLINE_TENANT=acme
# Ablation arm A4: true = every graph tool is unavailable (the agent must refuse to act).
FAULTLINE_DISABLE_GRAPH=false

# GitHub (demo repos; fine-grained token scoped to the two demo repos)
GITHUB_TOKEN=
DEMO_INFRA_REPO=Prashant-thakur77/faultline-demo-infra
DEMO_APP_REPO=Prashant-thakur77/faultline-demo-app
# Opt-in: open real PRs for the existing data-repair path (off for demos/evals)
FAULTLINE_CREATE_PR=false

# Backend / frontend
FAULTLINE_API_PORT=8400
NEXT_PUBLIC_FAULTLINE_API_URL=http://localhost:8400
FAULTLINE_DOMAIN=

# Optional tracing (self-hosted Arize Phoenix): uv sync --extra tracing
FAULTLINE_TRACING=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# Deployment (used only after the owner approves)
AWS_PROFILE=

# MCP over Streamable HTTP (make mcp-http): comma-separated "<bearer key>:<tenant>" pairs, keys ≥ 24 chars.
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
FAULTLINE_MCP_KEYS=
FAULTLINE_MCP_RATE_PER_MIN=30
